---
// The 1200×630 link-preview image (public/og.jpg) is a screenshot of this page.
// Regenerate it with `npm run share-image` after changing this page.
// Not linked anywhere, kept out of search and out of the sitemap.
import Layout from '../layouts/Layout.astro';
import Art from '../components/Art.astro';
import StackedText from '../components/StackedText.astro';
import DripBand from '../components/DripBand.astro';
import navDrips from '../data/drips/nav-drips.json';
import sunburst from '../assets/art/hero/sunburst.svg';
import ringOuter from '../assets/art/hero/ring-outer.svg';
import ringMid from '../assets/art/hero/ring-mid.svg';
import ringInner from '../assets/art/hero/ring-inner.svg';
import smokeLeft from '../assets/art/hero/smoke-left.svg';
import smokeRight from '../assets/art/hero/smoke-right.svg';
import smokeTop from '../assets/art/hero/smoke-top.svg';
import owl from '../assets/art/hero/owl-duo.svg';
import starMustard from '../assets/art/hero/star-mustard.svg';
import starCream from '../assets/art/hero/star-cream.svg';
import sparkleMustard from '../assets/art/hero/sparkle-mustard.svg';
import burstCream from '../assets/art/hero/burst-cream.svg';
import sparkleMustardSm from '../assets/art/hero/sparkle-mustard-sm.svg';
import openSticker from '../assets/art/hero/open-sticker.svg';
import pillSparkle from '../assets/art/hero/sparkle-pill.svg';
import drip1 from '../assets/art/hero/drip-1.svg';
import drip2 from '../assets/art/hero/drip-2.svg';
import drip3 from '../assets/art/hero/drip-3.svg';
import tagline from '../assets/art/hero/tagline.svg';
---

<Layout title="The Hut share card" noindex>
  <div class="card relative overflow-hidden bg-green">
    <!-- Sunburst centered on the ring stage, like the home page hero. -->
    <img src={sunburst.src} alt="" class="sunburst absolute block max-w-none" />

    <div class="stage absolute" aria-hidden="true">
      <Art src={ringOuter.src} x={-4} y={-4} w={900} h={889.52} />
      <Art src={ringMid.src} x={58.68} y={34.73} w={783.65} h={785.76} />
      <Art src={ringInner.src} x={121.03} y={97.63} w={666.39} h={671.37} />
      <Art src={smokeLeft.src} x={154.5} y={6.02} w={83} h={308} />
      <Art src={smokeRight.src} x={654.5} y={-33.98} w={83} h={328} />
      <Art src={smokeTop.src} x={372} y={-123.98} w={68} h={228} />
      <Art src={owl.src} x={276} y={275.02} w={349.09} h={320.1} />
      <Art src={starMustard.src} x={738.42} y={112.44} w={51.16} h={51.16} />
      <Art src={starCream.src} x={768.81} y={212.83} w={24.38} h={24.38} />
      <Art src={sparkleMustard.src} x={68.81} y={72.83} w={34.38} h={34.38} />
      <Art src={burstCream.src} x={108.42} y={722.44} w={21.16} h={21.16} />
      <Art src={sparkleMustardSm.src} x={758.81} y={682.83} w={28.38} h={28.38} />
      <Art src={openSticker.src} x={611.71} y={531.81} w={186.78} h={187.53} />
    </div>

    <div class="copy absolute">
      <p class="kicker inline-flex items-center rounded-full border-3 border-ink bg-cream font-label uppercase text-ink">
        <img src={pillSparkle.src} alt="" class="kicker-sparkle" />
        Glassboro’s late-night sub shack
      </p>
      <div class="headline relative isolate">
        <StackedText as="p" designSize={150} layers={12} outline class="headline-text text-cream">
          Get<br />Toasted.
        </StackedText>
        <img src={drip1.src} alt="" class="absolute -z-10" style="left:0.99em;top:1.44em;width:0.22em;height:0.8667em" />
        <img src={drip2.src} alt="" class="absolute -z-10" style="left:2.7933em;top:1.44em;width:0.1867em;height:0.5867em" />
        <img src={drip3.src} alt="" class="absolute -z-10" style="left:3.8667em;top:1.44em;width:0.2467em;height:1.08em" />
      </div>
      <img src={tagline.src} alt="" class="tagline block" />
    </div>

    <p class="domain absolute font-label uppercase text-mustard">thehutglassboro.com</p>

    <DripBand data={navDrips} class="z-20" />
  </div>
</Layout>

<style>
  .card {
    --su: 0.62px;
    width: 1200px;
    height: 630px;
  }
  .stage {
    left: 640px;
    top: 72px;
    width: calc(892 * var(--su));
    height: calc(881 * var(--su));
  }
  /* Ray origin sits at stage (446, 430). */
  .sunburst {
    width: 2400px;
    height: 2400px;
    left: calc(640px + 446 * var(--su) - 1200px);
    top: calc(72px + 430 * var(--su) - 1200px);
  }
  .copy {
    left: 72px;
    top: 118px;
    z-index: 10;
  }
  .kicker {
    gap: 10px;
    padding: 8px 18px;
    font-size: 16px;
    letter-spacing: 0.4px;
  }
  .kicker-sparkle {
    width: 17px;
  }
  .headline {
    margin-top: 22px;
    font-size: 136px;
  }
  .headline :global(.headline-text) {
    line-height: 0.92;
  }
  .tagline {
    margin-top: 96px;
    width: 330px;
    height: auto;
  }
  .domain {
    left: 72px;
    bottom: 36px;
    font-size: 18px;
    letter-spacing: 0.9px;
  }
</style>
