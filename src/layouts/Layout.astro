---
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'The Hut — Toasted Subs & Late-Night Munchies · Glassboro, NJ',
  description = 'Toasted subs dunked in house garlic butter & parm, kati rolls, and munchies for when the night gets weird. Halal. Open late.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Preview build: keep out of search until the restaurant has its own domain. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121210" />
    <script is:inline>
      // Opt in to scroll reveals only if the visitor hasn't asked for reduced motion.
      // If the motion script never loads, drop the class so nothing stays hidden.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(() => window.__motionReady || document.documentElement.classList.remove('motion'), 4000);
      }
    </script>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace('//', '/')} />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
