---
// Card illustrations. Every piece sits on a fixed 340×230 stage (design px, border included)
// that stays centered as the card resizes.
import Layer from './Layer.astro';
import type { MenuArt } from '../../data/site';

import rays from '../../assets/art/menu/rays.svg';
import blobSubs from '../../assets/art/menu/blob-subs.svg';
import blobSteaks from '../../assets/art/menu/blob-steaks.svg';
import blobRolls from '../../assets/art/menu/blob-rolls.svg';
import blobClassics from '../../assets/art/menu/blob-classics.svg';
import blobMunchies from '../../assets/art/menu/blob-munchies.svg';
import lettuce from '../../assets/art/menu/lettuce.svg';
import cheeseSubs from '../../assets/art/menu/cheese-subs.svg';
import steakCheese from '../../assets/art/menu/steak-cheese.svg';
import steakDrips from '../../assets/art/menu/steak-drips.svg';
import seedA from '../../assets/art/menu/seed-a.svg';
import seedB from '../../assets/art/menu/seed-b.svg';
import katiRoll from '../../assets/art/menu/kati-roll.svg';
import steamA from '../../assets/art/menu/steam-a.svg';
import steamB from '../../assets/art/menu/steam-b.svg';
import bowl from '../../assets/art/menu/bowl.svg';
import carton from '../../assets/art/menu/carton.svg';
import cartonDot from '../../assets/art/menu/carton-dot.svg';

interface Props {
  art: MenuArt;
}
const { art } = Astro.props;

const blobs = {
  subs: { src: blobSubs.src, x: 73.24, y: 24.24, s: 195.526, bleed: '-0.77%' },
  steaks: { src: blobSteaks.src, x: 74.2, y: 25.2, s: 193.605, bleed: '-0.77%' },
  rolls: { src: blobRolls.src, x: 73.58, y: 24.58, s: 194.845, bleed: '-0.77%' },
  classics: { src: blobClassics.src, x: 72.86, y: 23.86, s: 196.274, bleed: '-0.76%' },
  munchies: { src: blobMunchies.src, x: 72.77, y: 23.77, s: 196.453, bleed: '-0.76%' },
};
const blob = blobs[art];

// What each drawing shows, for screen readers and search engines.
const labels = {
  subs: 'Illustration of a toasted sub with lettuce, cheese and a sesame roll',
  steaks: 'Illustration of a cheesesteak with melted cheese and onions',
  rolls: 'Illustration of a kati roll',
  classics: 'Illustration of a steaming bowl of soup',
  munchies: 'Illustration of a carton of fries',
};

// Sesame seeds: [left, top, tilt] of each 7.946×6.153 slot, in design px.
const seeds: [number, number, number][] = [
  [82.23, 68.2, 20], [111.2, 72.81, -20], [137.43, 68.2, 20], [166.4, 72.81, -20],
  [192.63, 68.2, 20], [221.6, 72.81, -20], [247.83, 68.2, 20],
];

// Fries: [left, top, slotW, slotH, fryH, deg]
const fries: [number, number, number, number, number, number][] = [
  [102, 36.98, 15.852, 116.669, 116.461, -0.91],
  [117.08, 26.33, 17.314, 97.727, 97.306, 1.96],
  [130.03, 31.61, 22.717, 104.243, 103.428, 4.86],
  [155.28, 24.72, 15.922, 97.088, 96.828, 1.14],
  [175.37, 37.32, 14.232, 111.535, 111.506, 0.12],
  [194, 19.89, 23.231, 110.255, 109.462, -4.86],
  [212.4, 26.56, 21.817, 101.482, 100.696, -4.48],
  [230.8, 27.41, 25.126, 119.995, 119.207, -5.39],
];
---

<div role="img" aria-label={labels[art]} class="relative h-[230px] w-full overflow-hidden rounded-[26px] border-3 border-ink bg-green-deep">
  <div class="stage absolute top-[-3px] left-1/2 h-[230px] w-[340px] -translate-x-1/2">
    <div class="rays absolute" style="left:-329px;top:-373px;width:1000px;height:1000px">
      <img src={rays.src} alt="" class="block size-full max-w-none" />
    </div>

    <Layer src={blob.src} x={blob.x} y={blob.y} w={blob.s} h={blob.s} bleed={blob.bleed} class="blob" />

    {
      art === 'subs' && (
        <Fragment>
          <Layer src={lettuce.src} x={51.4} y={119.7} w={239.2} h={16.2} bleed="-9.26% -0.63%" />
          <Layer src={cheeseSubs.src} x={65.2} y={112.8} w={211.6} h={23.925} bleed="-6.27% -0.71%" />
          <div class="absolute rounded-[7px] border-3 border-ink bg-meat" style="left:60.6px;top:105.9px;width:220.8px;height:14px" />
          <div class="absolute rounded-[27.6px] border-3 border-ink bg-bread" style="left:56px;top:62.2px;width:230px;height:52.9px" />
          {seeds.map(([x, y, deg]) => (
            <Layer src={deg > 0 ? seedA.src : seedB.src} x={x + 0.473} y={y + 1.0765} w={7} h={4} rotate={deg} />
          ))}
          <div class="absolute rounded-[18.4px] border-3 border-ink bg-bread" style="left:58.3px;top:145px;width:225.4px;height:36.8px" />
        </Fragment>
      )
    }

    {
      art === 'steaks' && (
        <Fragment>
          {/* No lettuce: a solid layer of melted cheese with onion slivers, dripping over the bottom bun. */}
          <Layer src={steakCheese.src} x={51.5} y={119.67} w={239} h={25} />
          <div class="absolute rounded-[7px] border-3 border-ink bg-meat" style="left:60.6px;top:112.18px;width:220.8px;height:14px" />
          <div class="absolute rounded-[27.6px] border-3 border-ink bg-bread" style="left:56px;top:68.47px;width:230px;height:52.9px" />
          {seeds.map(([x, y, deg]) => (
            <Layer src={deg > 0 ? seedA.src : seedB.src} x={x + 0.473} y={y + 1.0765 + 6.27} w={7} h={4} rotate={deg} />
          ))}
          <div class="absolute rounded-[18.4px] border-3 border-ink bg-bread" style="left:58.3px;top:138.72px;width:225.4px;height:36.8px" />
          <Layer src={steakDrips.src} x={101.5} y={137.23} w={152} h={23} />
        </Fragment>
      )
    }

    {
      art === 'rolls' && (
        <Layer src={katiRoll.src} x={46} y={77} w={250} h={90} bleed="0 -4% 0 0" rotate={14} />
      )
    }

    {
      art === 'classics' && (
        <Fragment>
          <Layer src={steamA.src} x={135} y={30} w={33} h={70} bleed="-3.57% -7.58%" class="steam" />
          <Layer src={steamB.src} x={175} y={30} w={33} h={70} bleed="-3.57% -7.58%" class="steam" />
          <Layer src={steamA.src} x={211} y={30} w={33} h={70} bleed="-3.57% -7.58%" class="steam" />
          <Layer src={bowl.src} x={91} y={114} w={160} h={88} bleed="-1.7% -0.94%" />
          <div class="absolute rounded-[7px] border-3 border-ink bg-rim" style="left:86px;top:108px;width:170px;height:14px" />
        </Fragment>
      )
    }

    {
      art === 'munchies' && (
        <Fragment>
          {fries.map(([x, y, sw, sh, fh, deg]) => (
            <div
              class="absolute rounded-[3px] border-3 border-ink bg-mustard"
              style={`left:${x + (sw - 14) / 2}px;top:${y + (sh - fh) / 2}px;width:14px;height:${fh}px;transform:rotate(${deg}deg)`}
            />
          ))}
          <Layer src={carton.src} x={88.2} y={103.6} w={165.6} h={102.7} bleed="-1.46% -1.1%" />
          <Layer src={cartonDot.src} x={151} y={135.8} w={40} h={40} />
        </Fragment>
      )
    }
  </div>
</div>
