---
interface Props {
  [attr: `data-${string}`]: string | undefined;
  href?: string;
  /** Opens the order popup (pickup or delivery) instead of following a link. */
  order?: boolean;
  /** Where this Order button sits (e.g. "hero"), reported to Analytics with each tap. */
  placement?: string;
  variant?: 'cream' | 'mustard' | 'ink';
  size?: 'md' | 'lg' | 'xl';
  external?: boolean;
  class?: string;
}

const { href, order = false, placement, variant = 'cream', size = 'md', external = false, class: className = '', ...data } = Astro.props;

const variants = {
  cream: 'bg-cream text-ink',
  mustard: 'bg-mustard text-ink',
  ink: 'bg-ink text-mustard',
};
const sizes = {
  md: 'px-[22px] py-[11px] text-[15px] tracking-[0.45px]',
  lg: 'px-[26px] py-3 text-[18px] tracking-[0.54px]',
  xl: 'px-8 py-4 text-[22px] tracking-[0.66px]',
};
const classes = [
  'pill inline-flex cursor-pointer items-center justify-center rounded-full border-3 border-ink font-label uppercase whitespace-nowrap',
  variants[variant],
  sizes[size],
  className,
];
---

{
  order ? (
    <button type="button" popovertarget="order-popup" class:list={classes} data-track="order_open" data-placement={placement} {...data}>
      <slot />
    </button>
  ) : (
    <a href={href} class:list={classes} {...(external && { target: '_blank', rel: 'noopener' })} {...data}>
      <slot />
    </a>
  )
}

<style>
  /* Chunky offset shadow that the button "presses" into. */
  .pill {
    box-shadow: 0 6px 0 var(--color-ink);
    transition:
      transform 120ms ease-out,
      box-shadow 120ms ease-out;
  }
  .pill:hover {
    transform: translateY(2px);
    box-shadow: 0 4px 0 var(--color-ink);
  }
  .pill:active {
    transform: translateY(6px);
    box-shadow: 0 0 0 var(--color-ink);
  }
  .pill:focus-visible {
    outline: 3px solid var(--color-cream);
    outline-offset: 4px;
  }
</style>
