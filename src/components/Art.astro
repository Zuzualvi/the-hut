---
// A piece of art placed on a scaled canvas. Coordinates are design px;
// the parent sets the scale via a CSS unit variable (default --su).
interface Props {
  src: string;
  x: number;
  y: number;
  w: number;
  h: number;
  unit?: string;
  alt?: string;
  class?: string;
}

const { src, x, y, w, h, unit = '--su', alt = '', class: className = '' } = Astro.props;
const u = `var(${unit})`;
---

<img
  src={src}
  alt={alt}
  aria-hidden={alt ? undefined : 'true'}
  class:list={['absolute block max-w-none', className]}
  style={`left:calc(${x} * ${u});top:calc(${y} * ${u});width:calc(${w} * ${u});height:calc(${h} * ${u})`}
/>
