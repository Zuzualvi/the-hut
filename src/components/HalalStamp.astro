---
// The halal badge: a generic, widely recognized mark (Arabic "halal" in a ring),
// inlined so it takes the brand color of wherever it sits.
// `sticker`: ink badge on a cream disc with a hard shadow, for busy backgrounds.
// `line`: just the badge, in the current text color.
import halal from '../assets/art/badges/halal.svg?raw';

interface Props {
  variant?: 'sticker' | 'line';
  class?: string;
}
const { variant = 'line', class: className = '' } = Astro.props;
---

<span class:list={['halal-stamp block', `halal-${variant}`, className]} set:html={halal} />

<style>
  .halal-stamp :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .halal-sticker {
    border-radius: 9999px;
    background: var(--color-cream);
    color: var(--color-ink);
    box-shadow: var(--stamp-shadow, 5px) var(--stamp-shadow, 5px) 0 var(--color-ink);
  }
</style>
