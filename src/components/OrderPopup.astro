---
// The order popup: every Order button opens it (PillButton `order`). Pickup goes to Toast;
// delivery offers each delivery app. Built on the browser's popover, so it opens, closes on
// Escape or an outside tap, and works without JavaScript.
import StackedText from './StackedText.astro';
import PillButton from './PillButton.astro';
import { ORDER } from '../data/site';
---

<div id="order-popup" popover role="dialog" aria-labelledby="order-popup-title" class="order-popup bg-cream text-brown">
  <button type="button" popovertarget="order-popup" popovertargetaction="hide" class="close grid size-[42px] place-items-center rounded-full border-3 border-ink bg-mustard" aria-label="Close">
    <span class="x" aria-hidden="true"></span>
  </button>

  <StackedText as="h2" id="order-popup-title" designSize={40} layers={5} class="title pr-12 text-green">Pickup or delivery?</StackedText>

  <div class="flex flex-col gap-2.5">
    <PillButton href={ORDER.pickup} external variant="mustard" size="xl" class="w-full" data-track="order_choice" data-method="pickup" data-app="Toast">Pickup</PillButton>
    <p class="text-center text-[15px] leading-normal md:text-[16px]">Order ahead, grab it at the counter.</p>
  </div>

  <div class="flex flex-col gap-3">
    <p class="font-label text-[13px] uppercase tracking-[0.52px] text-green md:text-[15px]">Delivery with</p>
    <ul class="flex flex-col gap-3.5">
      {
        ORDER.delivery.map((d) => (
          <li>
            <PillButton href={d.href} external size="lg" class="w-full" data-track="order_choice" data-method="delivery" data-app={d.label}>{d.label}</PillButton>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const popup = document.getElementById('order-popup');
  if (popup) {
    const supported = 'popover' in HTMLElement.prototype;
    const show = (open: boolean) => {
      if (supported) open ? popup.showPopover() : popup.hidePopover();
      else popup.classList.toggle('is-open', open);
    };
    // Choosing an app opens it in a new tab; close the popup behind it.
    popup.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) show(false);
    });
    // Older browsers without popovers: open and close it ourselves.
    if (!supported) {
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[popovertarget="order-popup"]');
        if (btn) show(btn.getAttribute('popovertargetaction') !== 'hide');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') show(false);
      });
    }
  }
</script>

<style>
  .order-popup {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 60;
    width: min(440px, calc(100vw - 32px));
    height: fit-content;
    max-height: calc(100dvh - 32px);
    overflow: auto;
    margin: auto;
    padding: 26px 24px 28px;
    border: 4px solid var(--color-ink);
    border-radius: 30px;
    box-shadow: 8px 8px 0 var(--color-ink);
    flex-direction: column;
    gap: 22px;
  }
  /* Two rules, not one: browsers that don't know :popover-open would drop the pair. */
  .order-popup:popover-open {
    display: flex;
  }
  .order-popup.is-open {
    display: flex;
  }
  /* Ink at 60%. Written out because ::backdrop can't read the color variables in older browsers. */
  .order-popup::backdrop {
    background: rgb(18 18 16 / 0.6);
  }
  @media (min-width: 768px) {
    .order-popup {
      padding: 32px 32px 34px;
      border-radius: 36px;
      box-shadow: 12px 12px 0 var(--color-ink);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .order-popup:popover-open {
      animation: order-pop 180ms ease-out;
    }
  }
  @keyframes order-pop {
    from {
      opacity: 0;
      scale: 0.96;
    }
  }
  .order-popup :global(.title) {
    font-size: clamp(30px, 8vw, 40px);
    line-height: 1.1;
  }
  .order-popup :global(.pill:focus-visible),
  .close:focus-visible {
    outline: 3px solid var(--color-ink);
    outline-offset: 4px;
  }
  .close {
    position: absolute;
    top: 18px;
    right: 18px;
    cursor: pointer;
  }
  /* Same X as the open phone menu. */
  .x,
  .x::before {
    display: block;
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-ink);
    rotate: 45deg;
  }
  .x::before {
    content: '';
    rotate: 90deg;
  }
</style>
