---
// Footer: logo, tagline, links, and the shop's address and phone (on every page, for visitors and search engines).
import Art from '../Art.astro';
import HalalStamp from '../HalalStamp.astro';
import { NAV_LINKS, INSTAGRAM_URL, ORDER_URL, ADDRESS, PHONE, MAPS_URL } from '../../data/site';

import DripBand from '../DripBand.astro';
import goldDrips from '../../data/drips/gold-drips.json';
import owl from '../../assets/art/footer/owl.svg';
import wordmark from '../../assets/art/footer/wordmark.svg';
import tagline from '../../assets/art/footer/tagline.svg';
---

<footer class="footer relative overflow-hidden bg-ink text-center">
  <DripBand data={goldDrips} />

  <div class="owl-frame relative mx-auto" aria-hidden="true" data-reveal>
    <Art src={owl.src} x={30} y={60} w={239.35} h={218.9} unit="--fu" class="owl" />
  </div>

  <img data-reveal src={wordmark.src} alt="The Hut" class="wordmark mx-auto block h-auto" />
  <img data-reveal src={tagline.src} alt="Toasted Subs · Late-night · Munchies" class="tagline mx-auto block h-auto" />
  <div data-reveal="pop" class="footer-halal mx-auto">
    <HalalStamp class="size-full text-mustard" />
  </div>

  <nav aria-label="Footer">
    <ul class="links flex flex-col items-center font-label uppercase text-stone md:flex-row md:justify-center">
      {
        NAV_LINKS.map((l) => (
          <li>
            <a href={l.href} class="hover:text-mustard">{l.label}</a>
          </li>
        ))
      }
      <li><a href={ORDER_URL} target="_blank" rel="noopener" class="hover:text-mustard">Order Online</a></li>
      <li><a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="hover:text-mustard">Instagram</a></li>
    </ul>
  </nav>

  <address class="nap not-italic text-stone">
    <a href={MAPS_URL} target="_blank" rel="noopener" class="hover:text-mustard">The Hut · {ADDRESS.street}, {ADDRESS.city}, {ADDRESS.region} {ADDRESS.zip}</a>
    <span class="max-md:hidden" aria-hidden="true"> · </span>
    <a href={`tel:${PHONE.tel}`} class="hover:text-mustard">{PHONE.display}</a>
  </address>

  <p class="legal text-ash">© 2026 The Hut Glassboro · 100% Halal · Order via DoorDash</p>

  <div class="checks" aria-hidden="true"></div>
</footer>

<style>
  .footer {
    --fu: clamp(0.6px, calc(100vw / 1440), 1px);
    padding-top: calc(170 * var(--fu));
  }
  .owl-frame {
    width: calc(300 * var(--fu));
    height: calc(280 * var(--fu));
  }
  .wordmark {
    width: clamp(250px, 33.3vw, 480px);
    margin-top: calc(44 * var(--fu));
  }
  .tagline {
    width: clamp(230px, 27.7vw, 398px);
    margin-top: calc(45 * var(--fu));
  }
  .links {
    margin-top: 44px;
    gap: 14px 40px;
    font-size: clamp(14px, 1.25vw, 18px);
  }
  .nap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 36px;
    padding: 0 20px;
    font-size: clamp(14px, 1.15vw, 17px);
  }
  @media (min-width: 768px) {
    .nap {
      flex-direction: row;
      justify-content: center;
    }
  }
  .legal {
    margin-top: 28px;
    padding: 0 20px;
    font-size: clamp(12px, 1vw, 15px);
  }
  .checks {
    max-width: 1200px;
    margin: 44px auto 0;
    height: 64px;
    background: repeating-conic-gradient(var(--color-mustard) 0 25%, var(--color-brown) 0 50%) 0 0 / 64px 64px;
  }
  .footer-halal {
    width: clamp(76px, 7vw, 100px);
    height: clamp(76px, 7vw, 100px);
    margin-top: calc(48 * var(--fu));
  }
  .footer-halal :global(.halal-stamp) {
    rotate: -6deg;
  }
</style>
