---
// Hero. The art is a 892×881 "stage" built from design px and
// scaled with --su; on desktop the whole 1440×900 frame scales with --u.
import Art from '../Art.astro';
import StackedText from '../StackedText.astro';
import PillButton from '../PillButton.astro';
import HalalStamp from '../HalalStamp.astro';
import { ORDER_URL, MENU_URL } from '../../data/site';

import DripBand from '../DripBand.astro';
import navDrips from '../../data/drips/nav-drips.json';
import sunburst from '../../assets/art/hero/sunburst.svg';
import ringOuter from '../../assets/art/hero/ring-outer.svg';
import ringMid from '../../assets/art/hero/ring-mid.svg';
import ringInner from '../../assets/art/hero/ring-inner.svg';
import smokeLeft from '../../assets/art/hero/smoke-left.svg';
import smokeRight from '../../assets/art/hero/smoke-right.svg';
import smokeTop from '../../assets/art/hero/smoke-top.svg';
import owl from '../../assets/art/hero/owl-duo.svg';
import starMustard from '../../assets/art/hero/star-mustard.svg';
import starCream from '../../assets/art/hero/star-cream.svg';
import sparkleMustard from '../../assets/art/hero/sparkle-mustard.svg';
import burstCream from '../../assets/art/hero/burst-cream.svg';
import sparkleMustardSm from '../../assets/art/hero/sparkle-mustard-sm.svg';
import sparkleCreamSm from '../../assets/art/hero/sparkle-cream-sm.svg';
import openSticker from '../../assets/art/hero/open-sticker.svg';
import pillSparkle from '../../assets/art/hero/sparkle-pill.svg';
import drip1 from '../../assets/art/hero/drip-1.svg';
import drip2 from '../../assets/art/hero/drip-2.svg';
import drip3 from '../../assets/art/hero/drip-3.svg';
import tagline from '../../assets/art/hero/tagline.svg';
---

<section class="hero relative overflow-hidden bg-green" aria-labelledby="hero-title">
  <div class="canvas relative mx-auto">
    <!-- Stage: sunburst + wobble rings + owl, all in stage coords (origin = outer ring's top-left). -->
    <div class="stage absolute" aria-hidden="true" data-reveal="fade">
      <!-- Circular window onto the 3000px sunburst, centered on the ray origin (stage 446,430).
           Radius 1150 covers the hero's farthest corner while keeping the rotating layer small.
           Rays are wedges, so scaling about the center (--sbu) changes reach, not look. -->
      <div
        class="sunburst-wrap absolute overflow-hidden rounded-full"
        style="left:calc(446 * var(--su) - 1150 * var(--sbu));top:calc(430 * var(--su) - 1150 * var(--sbu));width:calc(2300 * var(--sbu));height:calc(2300 * var(--sbu))"
      >
        <img src={sunburst.src} alt="" class="sunburst absolute block max-w-none" style="left:calc(-350 * var(--sbu));top:calc(-350 * var(--sbu));width:calc(3000 * var(--sbu));height:calc(3000 * var(--sbu))" />
      </div>
      <Art src={ringOuter.src} x={-4} y={-4} w={900} h={889.52} class="wobble wobble-outer" />
      <Art src={ringMid.src} x={58.68} y={34.73} w={783.65} h={785.76} class="wobble wobble-mid" />
      <Art src={ringInner.src} x={121.03} y={97.63} w={666.39} h={671.37} class="wobble wobble-inner" />
      <Art src={smokeLeft.src} x={154.5} y={6.02} w={83} h={308} class="smoke" />
      <Art src={smokeRight.src} x={654.5} y={-33.98} w={83} h={328} class="smoke" />
      <Art src={smokeTop.src} x={372} y={-123.98} w={68} h={228} class="smoke" />
      <Art src={owl.src} x={276} y={275.02} w={349.09} h={320.1} class="owl" />
      <Art src={starMustard.src} x={738.42} y={112.44} w={51.16} h={51.16} class="twinkle" />
      <Art src={starCream.src} x={768.81} y={212.83} w={24.38} h={24.38} class="twinkle" />
      <Art src={sparkleMustard.src} x={68.81} y={72.83} w={34.38} h={34.38} class="twinkle" />
      <Art src={burstCream.src} x={108.42} y={722.44} w={21.16} h={21.16} class="twinkle" />
      <Art src={sparkleMustardSm.src} x={758.81} y={682.83} w={28.38} h={28.38} class="twinkle" />
      <Art src={openSticker.src} x={68.61} y={126.24} w={186.78} h={187.53} class="open-sticker" />
      <!-- Halal stamp and "Open till 2AM" sticker sit diagonally opposite each other (centers swapped at the owners' request). -->
      <div class="halal-rock absolute" style="left:calc(635.1 * var(--su));top:calc(555.58 * var(--su));width:calc(140 * var(--su));height:calc(140 * var(--su))">
        <HalalStamp variant="sticker" class="hero-halal size-full" />
      </div>
    </div>
    <p class="sr-only">Open till 2AM Fri &amp; Sat. 100% halal.</p>

    <div class="copy relative z-10" data-reveal-group>
      <p data-reveal class="kicker inline-flex items-center rounded-full border-3 border-ink bg-cream font-label uppercase text-ink">
        <img src={pillSparkle.src} alt="" class="kicker-sparkle" />
        Glassboro’s late-night sub shack
      </p>

      <div class="headline relative isolate" data-reveal>
        <StackedText as="h1" id="hero-title" designSize={150} layers={12} outline class="headline-text text-cream">
          Get<br />Toasted.
        </StackedText>
        <img src={drip1.src} alt="" aria-hidden="true" data-reveal="drip" class="drip absolute -z-10" style="left:0.99em;top:1.44em;width:0.22em;height:0.8667em" />
        <img src={drip2.src} alt="" aria-hidden="true" data-reveal="drip" class="drip absolute -z-10" style="left:2.7933em;top:1.44em;width:0.1867em;height:0.5867em" />
        <img src={drip3.src} alt="" aria-hidden="true" data-reveal="drip" class="drip absolute -z-10" style="left:3.8667em;top:1.44em;width:0.2467em;height:1.08em" />
      </div>

      <img data-reveal src={tagline.src} alt="Toasted Subs · Late-night · Munchies" class="tagline block" />

      <p class="blurb text-cream" data-reveal>
        Toasted subs lathered in house garlic butter and parm. Kati rolls, cheesesteaks, and munchies for those
        late-night cravings. Rowan-grown. Halal. Open late.
      </p>

      <div class="ctas relative" data-reveal>
        <PillButton href={ORDER_URL} variant="mustard" size="xl" external>Order Now</PillButton>
        <PillButton href={MENU_URL} size="xl">Peep the Menu</PillButton>
        <img src={sparkleCreamSm.src} alt="" aria-hidden="true" class="twinkle cta-sparkle absolute" />
      </div>
    </div>
  </div>

  <DripBand data={navDrips} class="z-20" />
</section>

<style>
  .hero {
    container-type: inline-size;
  }

  /* ---------- Mobile / tablet: stage on top, copy below ---------- */
  .canvas {
    --su: calc(100cqw / 900);
    --sbu: calc(100cqw / 440);
    --cu: min(0.62px, calc(100cqw / 880));
    padding-top: calc(170 * var(--su));
    padding-bottom: 56px;
  }
  .stage {
    position: relative;
    width: calc(892 * var(--su));
    height: calc(900 * var(--su));
    margin-left: calc(4 * var(--su));
  }
  .copy {
    padding: 0 20px;
    margin-top: 24px;
  }
  .kicker {
    gap: calc(10 * var(--cu));
    padding: calc(6 * var(--cu)) calc(16 * var(--cu));
    font-size: max(10px, calc(16 * var(--cu)));
    letter-spacing: 0.04em;
  }
  .kicker-sparkle {
    width: max(10px, calc(16 * var(--cu)));
    height: max(10px, calc(16 * var(--cu)));
  }
  .headline {
    margin-top: calc(26 * var(--cu));
    font-size: calc(150 * var(--cu));
  }
  .headline :global(.headline-text) {
    line-height: 0.92;
  }
  .tagline {
    margin-top: calc(114 * var(--cu));
    width: min(253px, 72vw);
    height: auto;
  }
  .blurb {
    margin-top: 24px;
    max-width: 540px;
    font-size: 15px;
    line-height: 1.55;
  }
  .ctas {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .ctas :global(.pill) {
    font-size: 16px;
    padding: 12px 24px;
  }
  .cta-sparkle {
    display: none;
  }

  /* ---------- Desktop: the 1440×900 design, scaled to fit ---------- */
  /* Scales to whichever is tighter: the window's width, or its height below the
     93px nav, so the Order and Menu buttons show on first load. It stops shrinking
     at 70% so text stays readable; shorter windows just scroll. */
  @media (min-width: 1024px) {
    .canvas {
      --u: min(1px, calc(100cqw / 1440), max(0.7px, calc((100svh - 93px) / 900)));
      --su: var(--u);
      /* Rays scale with the window, not the art, so they reach the edges when the
         art is narrower than the window (short or very wide windows). */
      --sbu: max(var(--u), calc(100vw / 1440));
      --cu: var(--u);
      width: calc(1440 * var(--u));
      height: calc(900 * var(--u));
      padding: 0;
    }
    .stage {
      position: absolute;
      left: calc(594 * var(--u));
      top: calc(39.98 * var(--u));
      margin: 0;
      height: calc(881.52 * var(--u));
    }
    .copy {
      position: absolute;
      left: calc(90 * var(--u));
      top: calc(150 * var(--u));
      width: calc(688 * var(--u));
      padding: 0;
      margin: 0;
    }
    .kicker {
      gap: calc(10 * var(--u));
      padding: calc(8.5 * var(--u)) calc(18 * var(--u));
      font-size: calc(14.6 * var(--u));
    }
    .kicker-sparkle {
      width: calc(16 * var(--u));
      height: calc(16 * var(--u));
    }
    .tagline {
      width: calc(360 * var(--u));
    }
    .blurb {
      margin-top: calc(34 * var(--u));
      width: calc(540 * var(--u));
      font-size: calc(20 * var(--u));
      line-height: 1.5;
    }
    .ctas {
      margin-top: calc(26 * var(--u));
      flex-direction: row;
      gap: calc(18 * var(--u));
    }
    .ctas :global(.pill) {
      font-size: calc(22 * var(--u));
      padding: calc(16 * var(--u)) calc(32 * var(--u));
    }
    .cta-sparkle {
      display: block;
      left: calc(2.81 * var(--u));
      top: calc(55 * var(--u));
      width: calc(16.38 * var(--u));
      height: calc(16.38 * var(--u));
    }
  }
  .stage :global(.hero-halal) {
    --stamp-shadow: calc(6 * var(--su));
    rotate: -8deg;
  }
</style>
