---
// Hero (Figma 16:36). The art is a 892×881 "stage" built from Figma coords and
// scaled with --su; on desktop the whole 1440×900 frame scales with --u.
import Art from '../Art.astro';
import StackedText from '../StackedText.astro';
import PillButton from '../PillButton.astro';
import { ORDER_URL } from '../../data/site';

import navDrips from '../../assets/figma/hero/nav-drips.svg';
import sunburst from '../../assets/figma/hero/sunburst.svg';
import ringOuter from '../../assets/figma/hero/ring-outer.svg';
import ringMid from '../../assets/figma/hero/ring-mid.svg';
import ringInner from '../../assets/figma/hero/ring-inner.svg';
import smokeLeft from '../../assets/figma/hero/smoke-left.svg';
import smokeRight from '../../assets/figma/hero/smoke-right.svg';
import smokeTop from '../../assets/figma/hero/smoke-top.svg';
import owl from '../../assets/figma/hero/owl-duo.svg';
import starMustard from '../../assets/figma/hero/star-mustard.svg';
import starCream from '../../assets/figma/hero/star-cream.svg';
import sparkleMustard from '../../assets/figma/hero/sparkle-mustard.svg';
import burstCream from '../../assets/figma/hero/burst-cream.svg';
import sparkleMustardSm from '../../assets/figma/hero/sparkle-mustard-sm.svg';
import sparkleCreamSm from '../../assets/figma/hero/sparkle-cream-sm.svg';
import openSticker from '../../assets/figma/hero/open-sticker.svg';
import pillSparkle from '../../assets/figma/hero/sparkle-pill.svg';
import drip1 from '../../assets/figma/hero/drip-1.svg';
import drip2 from '../../assets/figma/hero/drip-2.svg';
import drip3 from '../../assets/figma/hero/drip-3.svg';
import tagline from '../../assets/figma/hero/tagline.svg';
---

<section class="hero relative overflow-hidden bg-green" aria-labelledby="hero-title">
  <div class="canvas relative mx-auto">
    <!-- Stage: sunburst + wobble rings + owl, all in stage coords (origin = outer ring's top-left). -->
    <div class="stage absolute" aria-hidden="true" data-reveal="fade">
      <!-- Circular window onto the 3000px sunburst, centered on the ray origin (stage 446,430).
           Radius 1150 covers the hero's farthest corner while keeping the rotating layer small.
           Rays are wedges, so scaling about the center (--sbu) changes reach, not look. -->
      <div
        class="sunburst-wrap absolute overflow-hidden rounded-full"
        style="left:calc(446 * var(--su) - 1150 * var(--sbu));top:calc(430 * var(--su) - 1150 * var(--sbu));width:calc(2300 * var(--sbu));height:calc(2300 * var(--sbu))"
      >
        <img src={sunburst.src} alt="" class="sunburst absolute block max-w-none" style="left:calc(-350 * var(--sbu));top:calc(-350 * var(--sbu));width:calc(3000 * var(--sbu));height:calc(3000 * var(--sbu))" />
      </div>
      <Art src={ringOuter.src} x={-4} y={-4} w={900} h={889.52} class="wobble wobble-outer" />
      <Art src={ringMid.src} x={58.68} y={34.73} w={783.65} h={785.76} class="wobble wobble-mid" />
      <Art src={ringInner.src} x={121.03} y={97.63} w={666.39} h={671.37} class="wobble wobble-inner" />
      <Art src={smokeLeft.src} x={154.5} y={6.02} w={83} h={308} class="smoke" />
      <Art src={smokeRight.src} x={654.5} y={-33.98} w={83} h={328} class="smoke" />
      <Art src={smokeTop.src} x={372} y={-123.98} w={68} h={228} class="smoke" />
      <Art src={owl.src} x={276} y={275.02} w={349.09} h={320.1} class="owl" />
      <Art src={starMustard.src} x={738.42} y={112.44} w={51.16} h={51.16} class="twinkle" />
      <Art src={starCream.src} x={768.81} y={212.83} w={24.38} h={24.38} class="twinkle" />
      <Art src={sparkleMustard.src} x={68.81} y={72.83} w={34.38} h={34.38} class="twinkle" />
      <Art src={burstCream.src} x={108.42} y={722.44} w={21.16} h={21.16} class="twinkle" />
      <Art src={sparkleMustardSm.src} x={758.81} y={682.83} w={28.38} h={28.38} class="twinkle" />
      <Art src={openSticker.src} x={611.71} y={531.81} w={186.78} h={187.53} class="open-sticker" />
    </div>
    <p class="sr-only">Open till 2AM Fri &amp; Sat</p>

    <div class="copy relative z-10" data-reveal-group>
      <p data-reveal class="kicker inline-flex items-center rounded-full border-3 border-ink bg-cream font-label uppercase text-ink">
        <img src={pillSparkle.src} alt="" class="kicker-sparkle" />
        Glassboro’s late-night sub shack
      </p>

      <div class="headline relative isolate" data-reveal>
        <StackedText as="h1" id="hero-title" designSize={150} layers={12} outline class="headline-text text-cream">
          Get<br />Toasted.
        </StackedText>
        <img src={drip1.src} alt="" aria-hidden="true" data-reveal="drip" class="drip absolute -z-10" style="left:0.9833em;top:1.4333em;width:0.2133em;height:0.875em" />
        <img src={drip2.src} alt="" aria-hidden="true" data-reveal="drip" class="drip absolute -z-10" style="left:2.7867em;top:1.4333em;width:0.1867em;height:0.5983em" />
        <img src={drip3.src} alt="" aria-hidden="true" data-reveal="drip" class="drip absolute -z-10" style="left:3.86em;top:1.4333em;width:0.24em;height:1.09em" />
      </div>

      <img data-reveal src={tagline.src} alt="Toasted Subs · Late-night · Munchies" class="tagline block" />

      <p class="blurb text-cream" data-reveal>
        Toasted subs dunked in house garlic butter &amp; parm, kati rolls, and munchies for when the night gets weird.
        Rowan-grown. Halal. Open late.
      </p>

      <div class="ctas relative" data-reveal>
        <PillButton href={ORDER_URL} variant="mustard" size="xl" external>Order Now</PillButton>
        <PillButton href="#menu" size="xl">Peep the Menu</PillButton>
        <img src={sparkleCreamSm.src} alt="" aria-hidden="true" class="twinkle cta-sparkle absolute" />
      </div>
    </div>
  </div>

  <img src={navDrips.src} alt="" aria-hidden="true" data-reveal="drip" class="edge-art z-20" />
</section>

<style>
  .hero {
    container-type: inline-size;
  }

  /* ---------- Mobile / tablet: stage on top, copy below ---------- */
  .canvas {
    --su: calc(100cqw / 900);
    --sbu: calc(100cqw / 440);
    --cu: min(0.62px, calc(100cqw / 880));
    padding-top: calc(170 * var(--su));
    padding-bottom: 56px;
  }
  .stage {
    position: relative;
    width: calc(892 * var(--su));
    height: calc(900 * var(--su));
    margin-left: calc(4 * var(--su));
  }
  .copy {
    padding: 0 20px;
    margin-top: 24px;
  }
  .kicker {
    gap: calc(10 * var(--cu));
    padding: calc(6 * var(--cu)) calc(16 * var(--cu));
    font-size: max(10px, calc(16 * var(--cu)));
    letter-spacing: 0.04em;
  }
  .kicker-sparkle {
    width: max(10px, calc(16 * var(--cu)));
    height: max(10px, calc(16 * var(--cu)));
  }
  .headline {
    margin-top: calc(26 * var(--cu));
    font-size: calc(150 * var(--cu));
  }
  .headline :global(.headline-text) {
    line-height: 0.92;
  }
  .tagline {
    margin-top: calc(114 * var(--cu));
    width: min(290px, 74vw);
    height: auto;
  }
  .blurb {
    margin-top: 24px;
    max-width: 540px;
    font-size: 15px;
    line-height: 1.55;
  }
  .ctas {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .ctas :global(.pill) {
    font-size: 16px;
    padding: 12px 24px;
  }
  .cta-sparkle {
    display: none;
  }

  /* ---------- Desktop: the 1440×900 Figma frame, scaled to fit ---------- */
  @media (min-width: 1024px) {
    .canvas {
      --u: min(1px, calc(100cqw / 1440));
      --su: var(--u);
      --sbu: var(--u);
      --cu: var(--u);
      width: calc(1440 * var(--u));
      height: calc(900 * var(--u));
      padding: 0;
    }
    .stage {
      position: absolute;
      left: calc(594 * var(--u));
      top: calc(39.98 * var(--u));
      margin: 0;
      height: calc(881.52 * var(--u));
    }
    .copy {
      position: absolute;
      left: calc(90 * var(--u));
      top: calc(150 * var(--u));
      width: calc(688 * var(--u));
      padding: 0;
      margin: 0;
    }
    .kicker {
      gap: calc(10 * var(--u));
      padding: calc(8.5 * var(--u)) calc(18 * var(--u));
      font-size: calc(14.6 * var(--u));
    }
    .kicker-sparkle {
      width: calc(16 * var(--u));
      height: calc(16 * var(--u));
    }
    .tagline {
      width: calc(470 * var(--u));
    }
    .blurb {
      margin-top: calc(34 * var(--u));
      width: calc(540 * var(--u));
      font-size: calc(20 * var(--u));
      line-height: 1.5;
    }
    .ctas {
      margin-top: calc(26 * var(--u));
      flex-direction: row;
      gap: calc(18 * var(--u));
    }
    .ctas :global(.pill) {
      font-size: calc(22 * var(--u));
      padding: calc(16 * var(--u)) calc(32 * var(--u));
    }
    .cta-sparkle {
      display: block;
      left: calc(2.81 * var(--u));
      top: calc(55 * var(--u));
      width: calc(16.38 * var(--u));
      height: calc(16.38 * var(--u));
    }
  }
</style>
