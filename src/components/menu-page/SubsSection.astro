---
// Toasted Subs: sizing guide + sub groups (Figma "Section/Toasted Subs").
import StackedText from '../StackedText.astro';
import heroDrips from '../../assets/figma/marquee/hero-drips.svg';
import bgSparkle from '../../assets/figma/menu/bg-sparkle.svg';
import { SUB_SIZES, ALL_THE_WAY, SHAKE, SUB_GROUPS } from '../../data/site';

const sparkles: [string, string, number][] = [
  ['4%', '22%', 22], ['95%', '17%', 18], ['96%', '70%', 26], ['3.5%', '85%', 16],
];
---

<section id="subs" class="subs relative scroll-mt-20 overflow-hidden bg-cream px-5 md:px-[clamp(20px,8.3vw,120px)]">
  <div aria-hidden="true">
    {sparkles.map(([x, y, s]) => <img src={bgSparkle.src} alt="" class="absolute" style={`left:${x};top:${y};width:${s}px;height:${s}px`} />)}
    <img src={heroDrips.src} alt="" data-reveal="drip" class="edge-art" />
  </div>

  <div class="relative mx-auto flex max-w-[1200px] flex-col gap-7 md:gap-10">
    <header class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-6" data-reveal-group>
      <div class="flex flex-col gap-3.5">
        <StackedText data-reveal designSize={92} layers={9} class="title text-green">Toasted Subs</StackedText>
        <p data-reveal class="max-w-[640px] text-[clamp(16px,1.4vw,20px)] leading-normal text-brown">
          Every sub comes on a toasted roll brushed with house garlic butter &amp; parm. Pick a size, then pick your flavor.
        </p>
      </div>
      <p data-reveal class="price-sticker self-start rounded-full border-3 border-ink bg-mustard font-label uppercase text-ink md:self-auto">
        Half 8.99 &nbsp;·&nbsp; Full 15.99
      </p>
    </header>

    <div data-reveal class="guide grid gap-6 rounded-[30px] border-4 border-ink bg-green md:rounded-[36px] lg:grid-cols-[auto_minmax(0,1fr)_300px] lg:gap-12">
      <div class="flex flex-col gap-3 lg:gap-4">
        <p class="guide-label">1 · Pick a size</p>
        <div class="grid grid-cols-2 gap-3 lg:flex lg:gap-4">
          {
            SUB_SIZES.map((s) => (
              <div class="flex flex-col gap-0.5 rounded-[22px] border-3 border-ink bg-green-deep px-[18px] pt-3.5 pb-4 lg:rounded-[24px] lg:px-6 lg:pt-4 lg:pb-[18px]">
                <p class="font-label text-[13px] uppercase tracking-[0.52px] text-mustard lg:text-[15px]">{s.size}</p>
                <p class="font-display text-[42px] leading-[1.25] text-cream lg:text-[52px]">{s.inches}</p>
                <p class="font-label text-[13px] uppercase tracking-[0.4px] text-cream lg:text-[15px]">{s.nickname}</p>
                <p class="font-label text-[22px] text-mustard lg:text-[26px]">{s.price}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div class="flex flex-col gap-3 lg:gap-4">
        <p class="guide-label">2 · Get it all the way</p>
        <ul class="flex flex-wrap gap-2 lg:gap-2.5">
          {
            ALL_THE_WAY.map((t) => (
              <li class="rounded-full border-3 border-ink bg-cream px-3.5 py-[7px] font-label text-[13px] uppercase tracking-[0.26px] text-ink lg:px-4 lg:py-2 lg:text-[15px]">
                {t}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-col gap-2 lg:gap-4">
        <p class="guide-label">What’s the Shake?</p>
        <p class="text-[16px] leading-normal text-cream lg:text-[18px]">{SHAKE}</p>
      </div>
    </div>

    {
      SUB_GROUPS.map((g) => (
        <div class="flex flex-col gap-[18px] pt-2 md:gap-7 md:pt-0">
          <div class="flex items-center gap-3 md:gap-[18px]">
            <h3 class="shrink-0 rounded-full bg-ink px-4 py-2 font-label text-[15px] uppercase tracking-[0.6px] text-mustard md:px-5 md:py-[9px] md:text-[18px]">
              {g.title}
            </h3>
            <span class="leader text-brown" aria-hidden="true" />
            <p class="shrink-0 font-label text-[16px] text-brown md:text-[20px]">
              <span class="max-md:hidden">Half </span>8.99 / <span class="max-md:hidden">Full </span>15.99
            </p>
          </div>
          <ul class="grid gap-[18px] md:grid-cols-2 md:gap-7" data-reveal-group>
            {g.items.map((it) => (
              <li data-reveal class="item relative flex flex-col gap-2 rounded-[24px] border-3 border-ink bg-paper md:gap-2.5 md:rounded-[28px]">
                <div class="flex flex-wrap items-center gap-x-3.5 gap-y-2">
                  <h4 class="font-display text-[26px] leading-[1.15] text-green md:text-[32px]">{it.name}</h4>
                  <span class="rounded-full border-2 border-ink bg-mustard px-3 py-[5px] font-label text-[12px] uppercase tracking-[0.5px] text-ink md:text-[13px]">
                    {it.style}
                  </span>
                </div>
                <p class="text-[16px] leading-normal text-brown md:text-[18px]">{it.desc}</p>
                {it.fave && (
                  <span class="fave-tag absolute -top-2.5 right-3.5 rounded-full bg-ink px-3 py-1.5 font-label text-[11px] uppercase tracking-[0.5px] text-mustard md:right-[18px] md:px-3.5 md:py-[7px] md:text-[13px]">
                    ✦ Fan Fave
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .subs {
    padding-top: clamp(120px, 14.6vw, 210px);
    padding-bottom: clamp(80px, 9vw, 130px);
  }
  .subs :global(.title) {
    font-size: clamp(46px, 6.1vw, 88px);
    line-height: 1.05;
  }
  .price-sticker {
    padding: 10px 18px;
    font-size: 15px;
    letter-spacing: 0.04em;
    rotate: -2deg;
    box-shadow: 5px 5px 0 var(--color-ink);
  }
  @media (min-width: 768px) {
    .price-sticker {
      padding: 14px 26px;
      font-size: 20px;
      rotate: -3deg;
      box-shadow: 6px 6px 0 var(--color-ink);
    }
  }
  .guide {
    padding: 24px 22px 26px;
    box-shadow: 8px 8px 0 var(--color-ink);
  }
  @media (min-width: 1024px) {
    .guide {
      padding: 34px 40px 38px;
      box-shadow: 10px 10px 0 var(--color-ink);
    }
  }
  .guide-label {
    font-family: var(--font-label);
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mustard);
  }
  @media (min-width: 1024px) {
    .guide-label {
      font-size: 16px;
    }
  }
  .item {
    padding: 20px 22px 22px;
    box-shadow: 6px 6px 0 var(--color-ink);
  }
  @media (min-width: 768px) {
    .item {
      padding: 26px 30px 28px;
      box-shadow: 8px 8px 0 var(--color-ink);
    }
  }
  .fave-tag {
    rotate: 4deg;
  }
</style>
